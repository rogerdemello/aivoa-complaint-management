# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Groq --------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Model roles -------------------------------------------------------------
# Nodes in the LangGraph request a ROLE, never a hard-coded model ID. These are
# the assignment-mandated defaults; see README "Model availability" for why a
# runtime fallback exists. Leave blank to accept the built-in default.
#
#   router    - cheap intent classification (LOG / EDIT / DOCUMENT / QUESTION)
#   extractor - structured field extraction with evidence spans
#   reasoner  - risk assessment, CAPA, root cause (the hard reasoning)
AIVOA_MODEL_ROUTER=gemma2-9b-it
AIVOA_MODEL_EXTRACTOR=gemma2-9b-it
AIVOA_MODEL_REASONER=llama-3.3-70b-versatile

# Probe Groq at startup and auto-fall-back when a configured model is gone.
# Set to false to fail loudly instead of substituting (useful in CI).
AIVOA_MODEL_AUTO_FALLBACK=true

# --- Database ----------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler".
# Use the SESSION pooler (port 5432). The transaction pooler (6543) disables
# prepared statements, which breaks LangGraph's checkpointer.
# Format:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- App ---------------------------------------------------------------------
AIVOA_CORS_ORIGINS=http://localhost:5173
AIVOA_LOG_LEVEL=INFO
AIVOA_MAX_UPLOAD_MB=10
